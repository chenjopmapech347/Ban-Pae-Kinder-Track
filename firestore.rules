rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // แอปใช้ custom PIN auth (ไม่ใช่ Firebase Auth) จึงยังตรวจตัวตนฝั่ง rules ไม่ได้
    // มาตรการชั่วคราว: จำกัดเฉพาะ path ที่แอปใช้จริง, ห้ามลบ, ห้าม list ข้ามโรงเรียน
    // TODO: ย้ายไปใช้ Firebase Auth (custom token จาก Cloud Function ตรวจ PIN) แล้วเปลี่ยนเป็น request.auth != null

    // snapshot หลัก + สำรองรายวัน — อ่าน/สร้าง/แก้ได้ แต่ห้ามลบ
    match /schools/default/snapshots/{snapshotId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ข้อมูลรายวัน (volatile)
    match /schools/default/dailyData/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ตารางกิจกรรมภายใน-นอกห้องเรียน
    match /activitySchedule/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // กำหนดกิจกรรมมุมในห้อง / นอกห้อง (ถ้ามีในอนาคต)
    match /cornerAssignments/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // มาตรฐานที่ 2 — แบบประเมินตนเองรายครู (Std2SelfTab)
    match /std2_ratings/{teacherId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // บันทึกการซิงก์ (ช่วงทดสอบ) — สร้าง/อ่านได้ ห้ามแก้/ลบ
    match /schools/default/syncLogs/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // บันทึกการใช้งานระบบ (ใครทำอะไรเมื่อไร) — สร้าง/อ่านได้ ห้ามแก้/ลบ
    match /schools/default/systemLogs/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // อย่างอื่นทั้งหมดปิด (default deny)
  }
}
