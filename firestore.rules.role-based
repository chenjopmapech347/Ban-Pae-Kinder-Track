rules_version = '2';
// ── ร่าง rules แบบแยกตามบทบาท (Firebase Auth + custom claims, ไม่ใช้ Cloud Functions) ──
// ยังไม่ได้ deploy — อย่าใช้จนกว่า: (1) สร้างบัญชี+claims แล้ว (2) แอปรุ่น VITE_SERVER_AUTH=true ล็อกอินผ่านครบทุกบทบาท
// (3) ทดสอบใน Rules Playground แล้ว   ย้อนกลับ: คืนไฟล์ firestore.rules เดิมแล้ว deploy --only firestore:rules
// claims: role = admin | teacher | parent, className (ครู), studentId (ผู้ปกครอง)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role()     { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isAdmin()  { return role() == 'admin'; }
    function isStaff()  { return role() == 'admin' || role() == 'teacher'; }

    // snapshot หลัก — เฉพาะเจ้าหน้าที่ (ผู้ปกครองอ่าน parentView แทน)
    match /schools/default/snapshots/latest {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }
    // backup รายวัน — แอดมินอ่านเพื่อกู้คืน, เครื่องเจ้าหน้าที่เขียนได้ (id ต้องเป็นวันที่)
    match /schools/default/snapshots/{backupId} {
      allow read: if isAdmin();
      allow create, update: if isStaff() && backupId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow delete: if false;
    }
    // ข้อมูลรายบุตรหลาน — ผู้ปกครองอ่านได้เฉพาะเอกสารที่ id ตรงกับ studentId ใน token ของตัวเอง
    match /schools/default/parentView/{studentId} {
      allow read: if isStaff() || (role() == 'parent' && request.auth.token.get('studentId', '') == studentId);
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /schools/default/dailyData/{docId}        { allow read, create, update: if isStaff(); allow delete: if false; }
    // บันทึกการซิงก์ (ช่วงตรวจความเร็ว/ข้อผิดพลาด) — เจ้าหน้าที่เขียนได้, แอดมินอ่าน
    match /schools/default/syncLogs/{k}             { allow create: if isStaff(); allow read: if isAdmin(); allow update, delete: if false; }
    match /schools/default/classAssessments/{k}     { allow read, create, update: if isStaff(); allow delete: if false; }
    match /activitySchedule/{docId}                 { allow read, create, update: if isStaff(); allow delete: if false; }
    match /cornerAssignments/{docId}                { allow read, create, update: if isStaff(); allow delete: if false; }
    match /std2_ratings/{teacherId}                 { allow read, create, update: if isStaff(); allow delete: if false; }
    // อย่างอื่นทั้งหมด default deny
  }
}
