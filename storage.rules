rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // รูปภาพสื่อ — อ่านได้ทุกคน, เขียนได้เฉพาะไฟล์รูปไม่เกิน 5MB, ห้ามลบ
    // (แอปใช้ custom PIN auth ไม่มี request.auth)
    match /media-images/{imageId} {
      allow read: if true;
      allow create, update: if request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
    // ไฟล์อื่น ๆ — ต้อง login
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
